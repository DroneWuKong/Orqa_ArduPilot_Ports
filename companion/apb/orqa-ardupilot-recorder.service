[Unit]
Description=Orqa APB durable live DataFlash receiver
After=mavlink-router.service

[Service]
Type=simple
ExecStart=/opt/orqa-ardupilot-logger/venv/bin/python /usr/local/lib/orqa-ardupilot/recorder.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Nice=10
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
