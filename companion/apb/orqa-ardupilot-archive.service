[Unit]
Description=Orqa APB disarmed DataFlash archive (no erase)
After=mavlink-router.service

[Service]
Type=simple
ExecStart=/opt/orqa-ardupilot-logger/venv/bin/python /usr/local/lib/orqa-ardupilot/archive.py --watch
Restart=on-failure
RestartSec=30
Environment=PYTHONUNBUFFERED=1
Nice=10
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
